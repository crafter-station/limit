{
  "name": "@crafter/limit",
  "version": "0.0.0",
  "description": "Agent-first rate limiting SDK. BYO storage, multiserver-correct, by.agent as a first-class citizen.",
  "type": "module",
  "license": "MIT",
  "author": "Railly Hugo",
  "repository": {
    "type": "git",
    "url": "https://github.com/crafter-station/limit.git"
  },
  "keywords": [
    "rate-limiting",
    "ratelimit",
    "rate-limiter",
    "token-bucket",
    "redis",
    "agent",
    "agent-first",
    "serverless"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/adapters/memory.d.ts",
      "import": "./dist/adapters/memory.js"
    },
    "./redis": {
      "types": "./dist/adapters/redis.d.ts",
      "import": "./dist/adapters/redis.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "bun-types": "^1.3.14",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  }
}
