{
  "name": "@crafter/limit",
  "version": "0.1.0",
  "description": "Storage-agnostic rate limiting with a one-query Neon HTTP adapter.",
  "type": "module",
  "license": "MIT",
  "author": "Railly Hugo",
  "repository": {
    "type": "git",
    "url": "https://github.com/crafter-station/limit.git"
  },
  "keywords": [
    "rate-limiting",
    "ratelimit",
    "rate-limiter",
    "fixed-window",
    "neon",
    "postgres",
    "serverless"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/adapters/memory.d.ts",
      "import": "./dist/adapters/memory.js"
    },
    "./neon": {
      "types": "./dist/adapters/neon-http.d.ts",
      "import": "./dist/adapters/neon-http.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@neondatabase/serverless": "^1.1.0",
    "bun-types": "^1.3.14",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "@neondatabase/serverless": "^1.1.0"
  },
  "peerDependenciesMeta": {
    "@neondatabase/serverless": {
      "optional": true
    }
  }
}
